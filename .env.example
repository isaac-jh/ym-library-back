# YM Library Backend 환경변수 템플릿
# 이 파일을 복사하여 .env 로 저장한 뒤 값을 채워 사용합니다.
#   cp .env.example .env

# ----- 데이터베이스 -----
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ym
APP_ENV=development
DEBUG=True

# ----- 카탈로그 챗봇 / MCP -----
# https://aistudio.google.com/apikey 에서 발급
GOOGLE_API_KEY=changeme
GEMMA_MODEL=gemma-4-31b-it
MCP_SERVER_NAME=ym-library-mcp

# ----- CORS -----
# CSV 로 나열. credentials=True 를 사용하므로 와일드카드("*")는 사용 금지.
# (starlette 0.41+ 부터 명세 위반으로 헤더가 누락되어 브라우저가 차단함.)
CORS_ALLOWED_ORIGINS=https://ym-library.vercel.app,http://localhost:5173,http://localhost:3000

# (선택) 정규식 매칭 — 예: Vercel preview 배포까지 허용
# CORS_ALLOWED_ORIGIN_REGEX=^https://ym-library-.*\.vercel\.app$
