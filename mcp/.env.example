# YM Library MCP 서버 환경변수 템플릿
# 이 파일을 복사하여 mcp/.env 로 저장한 뒤 값을 채워 사용합니다.
#   cp mcp/.env.example mcp/.env

# ----- DB -----
# 루트 .env 의 DATABASE_URL 과 동일하게 두면 됩니다.
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/ym

# ----- LLM (Google AI Studio - Gemma 4) -----
# https://aistudio.google.com/apikey 에서 발급
GOOGLE_API_KEY=changeme
GEMMA_MODEL=gemma-4-31b-it

# ----- MCP 서버 -----
MCP_SERVER_NAME=ym-library-mcp

# ----- 챗봇 HTTP API -----
CHAT_API_HOST=0.0.0.0
CHAT_API_PORT=8001
# CSV 형식. 운영에서는 카탈로그 페이지 도메인만 화이트리스트하세요.
CHAT_CORS_ORIGINS=*
